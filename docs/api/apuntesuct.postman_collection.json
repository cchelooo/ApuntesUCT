{
  "info": {
    "name": "ApuntesUCT API",
    "description": "Colección generada desde el OpenAPI de api-gateway, auth-service y catalog-service (ver backend/scripts/export-postman-collection.cjs). Requiere los servicios levantados; auth y catalog necesitan su PostgreSQL. Importa también el environment apuntesuct.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API Gateway",
      "description": "Punto único de entrada a los microservicios de ApuntesUCT.",
      "item": [
        {
          "name": "Verifica el estado del servicio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/health",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "/api/v1/health (API Gateway)"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Health de Auth a través del gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/health",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "auth", "health"]
            },
            "description": "Ruta proxeada hacia Auth (no aparece en el OpenAPI del gateway porque el proxy es middleware). Responde 502 si Auth no acepta la conexión o tarda más de 5 segundos."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login mock a través del gateway",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mockEmail}}\",\n  \"password\": \"{{mockPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/auth/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Ruta proxeada hacia Auth (ver #91). Devuelve el JWT sin firma del login mock (#92). Responde 502 si Auth no está disponible."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        }
      ]
    },
