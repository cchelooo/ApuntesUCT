  },
  "item": [
    {
      "name": "API Gateway",
      "description": "Punto único de entrada a los microservicios de ApuntesUCT.",
      "item": [
        {
          "name": "API Gateway: Verifica que el API Gateway está operativo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/health",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Chequeo público de disponibilidad del Gateway. No consulta bases de datos ni otros microservicios."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Devuelve JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
