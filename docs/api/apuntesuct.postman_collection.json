    {
      "name": "Catalog Service",
      "description": "Microservicio de universidad, carrera, asignatura, profesor y sus relaciones.",
      "item": [
        {
          "name": "Verifica el estado del servicio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{catalogUrl}}/api/v1/health",
              "host": ["{{catalogUrl}}"],
              "path": ["api", "v1", "health"]
            },
