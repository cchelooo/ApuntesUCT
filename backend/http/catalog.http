### ============================================================================
### VARIABLES DE ENTORNO Y CONFIGURACIÓN
### ============================================================================
@baseUrl = http://localhost:3000/api/v1
@catalogDirectUrl = http://localhost:3002/api/v1
@contentType = application/json

# INSTRUCCIONES PARA OBTENER LOS IDs:
# 1. Obtener @universityId, @careerId y @subjectId ejecutando 1.1 (GET {{baseUrl}}/catalog).
# 2. Obtener @professorId ejecutando 1.2a (GET {{baseUrl}}/catalog/filter) seleccionando un 'id' del arreglo 'professors' de la asignatura elegida.
@universityId = b10cd461-93a7-4b66-a300-231fab5f0e28
@careerId = c4e13339-2dd8-49cf-8715-b8598a8dbcdc
@subjectId = 50a0e8e3-3e7b-4bcb-b663-3997e64c259d
@professorId = ba8c3fcc-0a08-419f-89b3-0f571ef649d1

@invalidUuid = 123-invalid-uuid
@nonExistentUuid = 00000000-0000-0000-0000-000000000000


###############################################
# 1. PRUEBAS DEL CATÁLOGO (PÚBLICO)
###############################################

### 1.1 Obtener árbol jerárquico completo (Vía Gateway)
# Esperado: 200 OK - Estructura Universidad -> Carrera -> Asignatura
# VERIFICACIÓN: Comprobar manualmente que cada objeto Asignatura contenga la propiedad 'semester' (e.g. semester: 1, 5, etc.)
GET {{baseUrl}}/catalog
Content-Type: {{contentType}}

###

### 1.1b Obtener árbol jerárquico directo (Catalog Service :3002)
# Esperado: 200 OK
GET {{catalogDirectUrl}}/catalog
Content-Type: {{contentType}}

###

### 1.2a Filtrado sin parámetros (Retorna raíz con profesores)
# USAR ESTA RESPUESTA PARA OBTENER UN professorId REAL ASOCIADO A LA ASIGNATURA SELECCIONADA
# Esperado: 200 OK
GET {{baseUrl}}/catalog/filter
Content-Type: {{contentType}}

###

### 1.2b Filtrado válido con secuencia completa hasta Profesor (Nivel 4)
# Esperado: 200 OK - Retorna las asignaturas coincidentes con sus relaciones (carrera, universidad y profesores)
GET {{baseUrl}}/catalog/filter?universityId={{universityId}}&careerId={{careerId}}&subjectId={{subjectId}}&professorId={{professorId}}
Content-Type: {{contentType}}

###

### 1.2c Filtrado con combinación sin coincidencias
# Esperado: 200 OK - Retorna un arreglo vacío []
GET {{baseUrl}}/catalog/filter?universityId={{universityId}}&careerId={{careerId}}&subjectId={{nonExistentUuid}}
Content-Type: {{contentType}}

###

### 1.3a Error: UUID con formato inválido
# Esperado: 400 Bad Request (ValidationPipe - IsUuid)
GET {{baseUrl}}/catalog/filter?universityId={{invalidUuid}}
Content-Type: {{contentType}}

###

### 1.3c Error: Salto de jerarquía (Asignatura sin Carrera)
# Esperado: 400 Bad Request
GET {{baseUrl}}/catalog/filter?universityId={{universityId}}&subjectId={{subjectId}}
Content-Type: {{contentType}}

###

### 1.3d Error: Salto de jerarquía (Profesor sin Asignatura)
# Esperado: 400 Bad Request
GET {{baseUrl}}/catalog/filter?universityId={{universityId}}&careerId={{careerId}}&professorId={{professorId}}
Content-Type: {{contentType}}

###

### 1.3h Alcance del dominio: 'year'/'type' se ignoran (ya no son de Catalog)
# Catalog ya NO acepta year/type: pertenecen a Material/Search. Con `whitelist`
# estos parámetros se descartan, por lo que la petición responde 200 (no 400).
# Esperado: 200 OK ignorando year/type
GET {{baseUrl}}/catalog/filter?universityId={{universityId}}&careerId={{careerId}}&subjectId={{subjectId}}&professorId={{professorId}}&year=2026&type=APUNTE
Content-Type: {{contentType}}

###

### 1.3g Error: Carrera sin Universidad (Ruptura de secuencia)
# Esperado: 400 Bad Request
GET {{baseUrl}}/catalog/filter?careerId={{careerId}}
Content-Type: {{contentType}}

###

### 1.4a Listar universidades activas (selector académico)
# Esperado: 200 OK - Arreglo de universidades activas ordenadas por nombre
GET {{baseUrl}}/catalog/universities
Content-Type: {{contentType}}

###

### 1.4b Listar carreras activas (todas)
# Esperado: 200 OK - Arreglo de carreras activas ordenadas por nombre
GET {{baseUrl}}/catalog/careers
Content-Type: {{contentType}}

###

### 1.4c Listar carreras de una universidad
# Esperado: 200 OK - Arreglo de carreras activas de la universidad indicada
GET {{baseUrl}}/catalog/careers?universityId={{universityId}}
Content-Type: {{contentType}}

###

### 1.4d Listar asignaturas activas de una carrera
# Esperado: 200 OK - Arreglo de asignaturas activas de la carrera indicada
GET {{baseUrl}}/catalog/subjects?careerId={{careerId}}
Content-Type: {{contentType}}

###

### 1.4e Listar profesores activos de una asignatura
# Esperado: 200 OK - Arreglo de profesores activos que dictan la asignatura indicada
GET {{baseUrl}}/catalog/professors?subjectId={{subjectId}}
Content-Type: {{contentType}}

###

### 1.5 Alcance del dominio: 'year'/'type' ya no pertenecen a Catalog
# Catalog solo modela la jerarquía universidad -> carrera -> asignatura -> profesor.
# Los metadatos de materiales (year/type) son de Material Service y la búsqueda
# por año/tipo corresponde a Search Service. Al enviarlos se ignoran (whitelist).
# Esperado: 200 OK (parámetros desconocidos descartados)
GET {{baseUrl}}/catalog/filter?universityId={{universityId}}&careerId={{careerId}}&subjectId={{subjectId}}&professorId={{professorId}}&year=2026&type=EXAM
Content-Type: {{contentType}}

###


###############################################
# 2. GESTIÓN DE ASIGNATURAS (OPERACIONES CRUD)
###############################################

### 2.1 Crear asignatura con carrera inexistente
# Esperado: 404 Not Found ("La carrera con ID ... no existe")
POST {{baseUrl}}/catalog/subjects
Content-Type: {{contentType}}

{
  "name": "Asignatura Huérfana",
  "code": "INV-999",
  "semester": 1,
  "careerId": "{{nonExistentUuid}}"
}

###

### 2.2 Crear asignatura con payload inválido/incompleto
# Esperado: 400 Bad Request
POST {{baseUrl}}/catalog/subjects
Content-Type: {{contentType}}

{
  "code": "INV-101"
}

###

### 2.3 Crear asignatura válida
# @name createSubject
# Esperado: 201 Created
# VERIFICACIÓN: Validar que el cuerpo de la respuesta contenga 'id', 'semester': 5 y que 'name', 'code' y 'careerId' correspondan con los valores enviados
POST {{baseUrl}}/catalog/subjects
Content-Type: {{contentType}}

{
  "name": "Arquitectura de Software",
  "code": "ICI-412-TMP",
  "semester": 5,
  "careerId": "{{careerId}}"
}

###

### 2.4 Crear asignatura duplicada (Mismo código)
# Esperado: 409 Conflict
POST {{baseUrl}}/catalog/subjects
Content-Type: {{contentType}}

{
  "name": "Arquitectura Duplicada",
  "code": "ICI-412-TMP",
  "semester": 5,
  "careerId": "{{careerId}}"
}

###

### 2.5 Eliminar la asignatura recién creada
# Utiliza automáticamente el ID retornado en la petición 2.3
# Esperado: 200 OK
DELETE {{baseUrl}}/catalog/subjects/{{createSubject.response.body.id}}
Content-Type: {{contentType}}

###

### 2.6 Eliminar asignatura inexistente
# Esperado: 404 Not Found
DELETE {{baseUrl}}/catalog/subjects/{{nonExistentUuid}}
Content-Type: {{contentType}}

###############################################
# 3. GESTIÓN DEL CATÁLOGO RESTAURADOR (OPERACIONES CRUD)
#    Payload inválido/incompleto y eliminación en cascada.
###############################################

### 3.1 Crear universidad con payload inválido/incompleto
# Esperado: 400 Bad Request
POST {{baseUrl}}/catalog/universities
Content-Type: {{contentType}}

{
  "name": "Universidad Sin Codigo"
}

###

### 3.2 Crear universidad válida
# Esperado: 201 Created
# Guarda el ID para los casos siguientes
POST {{baseUrl}}/catalog/universities
Content-Type: {{contentType}}

{
  "name": "Universidad de Prueba HTTP",
  "code": "HTTP-221",
  "active": true
}

###

### 3.3 Crear universidad duplicada (Mismo código)
# Esperado: 409 Conflict
POST {{baseUrl}}/catalog/universities
Content-Type: {{contentType}}

{
  "name": "Universidad Duplicada",
  "code": "HTTP-221"
}

###

### 3.4 Crear carrera válida en la universidad creada en 3.2
# Esperado: 201 Created
POST {{baseUrl}}/catalog/careers
Content-Type: {{contentType}}

{
  "universityId": "{{createUniversity.response.body.id}}",
  "name": "Carrera de Prueba HTTP",
  "code": "HTTP-C221",
  "active": true
}

###

### 3.5 Crear carrera con universidad inexistente
# Esperado: 404 Not Found
POST {{baseUrl}}/catalog/careers
Content-Type: {{contentType}}

{
  "universityId": "{{nonExistentUuid}}",
  "name": "Carrera Huérfana",
  "code": "HUE-221"
}

###

### 3.6 Crear profesor válido vinculado a una asignatura
# Esperado: 201 Created
POST {{baseUrl}}/catalog/professors
Content-Type: {{contentType}}

{
  "name": "Profesor de Prueba HTTP",
  "email": "profesor.http221@uct.cl",
  "subjectIds": ["{{subjectId}}"]
}

###

### 3.7 Crear profesor con email duplicado
# Esperado: 409 Conflict
POST {{baseUrl}}/catalog/professors
Content-Type: {{contentType}}

{
  "name": "Profesor Duplicado",
  "email": "profesor.http221@uct.cl"
}

###

### 3.8 Crear profesor con asignatura inexistente
# Esperado: 404 Not Found
POST {{baseUrl}}/catalog/professors
Content-Type: {{contentType}}

{
  "name": "Profesor con Asignatura Inexistente",
  "email": "profesor.otro221@uct.cl",
  "subjectIds": ["{{nonExistentUuid}}"]
}

###

### 3.9 Eliminar profesor válido
# Esperado: 200 OK
DELETE {{baseUrl}}/catalog/professors/{{createProfessor.response.body.id}}
Content-Type: {{contentType}}

###

### 3.10 Eliminar profesor inexistente
# Esperado: 404 Not Found
DELETE {{baseUrl}}/catalog/professors/{{nonExistentUuid}}
Content-Type: {{contentType}}

###

### 3.11 Eliminar universidad en cascada
# Elimina también la carrera creada en 3.4 y sus asignaturas/recursos.
# Esperado: 200 OK
DELETE {{baseUrl}}/catalog/universities/{{createUniversity.response.body.id}}
Content-Type: {{contentType}}

###

### 3.12 Verificar que la carrera fue eliminada en cascada
# Esperado: 404 Not Found
DELETE {{baseUrl}}/catalog/careers/{{createCareer.response.body.id}}
Content-Type: {{contentType}}

###
