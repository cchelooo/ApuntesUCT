PORT=3003
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=materials
# Completar con las credenciales del usuario de servicio de MinIO.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
DATABASE_URL="postgresql://uct_admin:uct_password_123@localhost:5436/material_db?schema=public"

# Identidad de autor (#446). La subida y el versionado exigen
# Authorization: Bearer <JWT firmado> con claim sub = UUID del usuario.
# HS256: secreto compartido con Auth (solo desarrollo/integración).
JWT_ACCESS_SECRET=
# RS256/ES256: clave pública PEM de Auth (recomendado en producción).
# En una sola línea usar \n para los saltos de línea del PEM.
JWT_ACCESS_PUBLIC_KEY=
# Opcionales: si se definen, se validan iss y aud del token.
JWT_ISSUER=
JWT_AUDIENCE=
JWT_CLOCK_TOLERANCE_SECONDS=5

# Contexto temporal de desarrollo. Solo funciona con NODE_ENV=development.
# Deshabilitado por defecto: no es autenticación y no debe usarse en producción.
MATERIAL_LOCAL_AUTHOR_ENABLED=false
MATERIAL_LOCAL_UPLOADER_ID=
MATERIAL_LOCAL_UNIVERSITY_ID=


#Carga de catalog service configuration
CATALOG_SERVICE_URL=http://localhost:3002/api/v1
CATALOG_TIMEOUT_MS=5000