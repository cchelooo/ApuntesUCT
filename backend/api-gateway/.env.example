PORT=3000
# Orígenes de los microservicios, sin /api/v1. Si se ejecuta en contenedores, usar su DNS interno.
AUTH_SERVICE_URL=http://127.0.0.1:3001
CATALOG_SERVICE_URL=http://127.0.0.1:3002
MATERIAL_SERVICE_URL=http://127.0.0.1:3003
SEARCH_SERVICE_URL=http://127.0.0.1:3005
# URLs de Swagger accesibles desde el navegador, usadas en el índice /api/docs.
AUTH_DOCS_URL=http://localhost:3001/api/docs
CATALOG_DOCS_URL=http://localhost:3002/api/docs
MATERIAL_DOCS_URL=http://localhost:3003/api/docs
SEARCH_DOCS_URL=http://localhost:3005/api/docs
