{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true
      }
    ],
    "^.+\\.m?js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "CommonJS",
          "moduleResolution": "Node"
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|http-proxy-middleware|httpxy|is-plain-obj)/)"
  ]
}
