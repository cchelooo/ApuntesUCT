generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  careers   Career[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("universities")
}

model Career {
  id           String     @id @default(uuid())
  universityId String     @map("university_id")
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  code         String
  active       Boolean    @default(true)
  subjects     Subject[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([universityId, code])
  @@index([universityId])
  @@map("careers")
}

model Subject {
  id          String      @id @default(uuid())
  careerId    String      @map("career_id")
  career      Career      @relation(fields: [careerId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  active      Boolean     @default(true)
  professors  Professor[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@unique([careerId, code])
  @@index([careerId])
  @@map("subjects")
}

model Professor {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  active    Boolean   @default(true)
  subjects  Subject[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("professors")
}