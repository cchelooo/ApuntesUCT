generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  SUMMARY
  EXAM
  GUIDE
  CLASS_NOTES
  OTHER
}

model University {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  careers   Career[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("universities")
}

model Career {
  id           String     @id @default(uuid())
  universityId String     @map("university_id")
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  code         String
  active       Boolean    @default(true)
  subjects     Subject[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([universityId, code])
  @@index([universityId])
  @@map("careers")
}

model Subject {
  id          String      @id @default(uuid())
  careerId    String      @map("career_id")
  career      Career      @relation(fields: [careerId], references: [id], onDelete: Cascade)
  code        String
  semester    Int         @default(1)
  name        String
  description String?
  active      Boolean     @default(true)
  professors  Professor[]
  resources   Resource[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@unique([careerId, code])
  @@index([careerId])
  @@map("subjects")
}

model Professor {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  active    Boolean    @default(true)
  subjects  Subject[]
  resources Resource[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("professors")
}

model Resource {
  id          String       @id @default(uuid())
  subjectId   String       @map("subject_id")
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  professorId String?      @map("professor_id")
  professor   Professor?   @relation(fields: [professorId], references: [id], onDelete: SetNull)
  title       String
  description String?
  fileUrl     String       @map("file_url")
  year        Int
  type        ResourceType
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([subjectId])
  @@index([year, type])
  @@map("resources")
}