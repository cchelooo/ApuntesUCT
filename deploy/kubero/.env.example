# Only for the isolated local Compose environment. Use separate secrets in Kubero.
POSTGRES_PASSWORD=local-kubero-postgres-change-me
MINIO_ROOT_USER=apuntes-local
MINIO_ROOT_PASSWORD=local-kubero-minio-change-me
WEB_PORT=18080
GATEWAY_PORT=13000
# Absolute host path to an external RSA PEM; mounted read-only only into Auth.
JWT_PRIVATE_KEY_FILE=
JWT_ISSUER=apuntesuct-auth
JWT_AUDIENCE=apuntesuct-api
